# PrestaShop Docker Configuration
# Skopiuj ten plik do .env i dostosuj wartości

# === Instalacja ===
PS_INSTALL_AUTO=1

# === Lokalizacja ===
PS_LANGUAGE=pl
PS_COUNTRY=PL

# === Konto administratora ===
PS_ADMIN_EMAIL=admin@prestashop.com
PS_ADMIN_PASSWD=Admin123

# === Bezpieczeństwo - Nazwy folderów ===
# WAŻNE: Te foldery są automatycznie zmieniane podczas instalacji!
# Ustaw własne losowe nazwy lub zostaw domyślne

# Folder admin (zamiast /admin)
# Przykład: admin_a1b2c3d4, myadmin, backend_xyz
PS_FOLDER_ADMIN=admin333

# Folder install (zostanie usunięty po instalacji)
# Przykład: install_xyz, setup_abc
PS_FOLDER_INSTALL=install_old

# === Generowanie losowych nazw ===
# Jeśli chcesz automatycznie generować losowe nazwy przy każdym uruchomieniu,
# użyj tego w terminalu przed docker compose up:
#
# export PS_FOLDER_ADMIN=admin_$(openssl rand -hex 4)
# export PS_FOLDER_INSTALL=install_$(openssl rand -hex 4)
# docker compose up -d
